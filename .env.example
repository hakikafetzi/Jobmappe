# Copy this file to .env and adjust the values.
# Docker Compose reads .env automatically.

# Image version of backend and frontend.
# Pin a release (e.g. 1.0.0) for stable updates; "latest" always pulls the newest one.
JOBMAPPE_VERSION=latest

# Port on the host where JobMappe is reachable (http://localhost:<port>)
JOBMAPPE_PORT=8080

# Database
DB_NAME=jobmappe
DB_USER=jobmappe
# Required. Use a strong password, e.g. generated with: openssl rand -base64 24
# Note: it is only applied when the database is created for the first time.
DB_PASSWORD=

# Optional: to run a second, 
# separate instance, copy this folder and use another project name and port.
# COMPOSE_PROJECT_NAME=jobmappe-demo